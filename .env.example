# Supabase Project Credentials (Create a new project on Supabase as per constraints)
VITE_SUPABASE_URL=https://your-new-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Stripe API Public Key (Mock mode is enabled by default for testing)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sample

# Note: If environment variables are omitted or pending project creation,
# the platform automatically defaults to its built-in full-fidelity state engine
# pre-seeded with all PRD users, charities, draws, and verification queues.
